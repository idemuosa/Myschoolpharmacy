# DATABASE (Use a cloud DB like AWS RDS, Railway PG, or Supabase)
DATABASE_URL=postgresql://user:password@host:port/dbname

# DJANGO SECURITY
SECRET_KEY=generate-a-long-random-string-here
DEBUG=False
ALLOWED_HOSTS=your-backend-domain.com

# CORS (Allow your frontend to talk to this API)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5173

# REDIS (For Celery/Tasks)
REDIS_URL=redis://your-redis-host:6379/0

# SECURITY HEADERS (Recommended)
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://your-backend-domain.com
