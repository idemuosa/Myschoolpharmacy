# Django Production Environment Configuration

# Security Settings
DEBUG=False
SECRET_KEY=your-production-secret-key-change-this-in-production
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# Option 1: Full connection URL
DATABASE_URL=postgres://pharmacy_user:pharmacy_password@localhost:5432/pharmacy_db

# Option 2: Individual DB Parameters (Used if DATABASE_URL is not set)
# DB_NAME=pharmacy_db
# DB_USER=pharmacy_user
# DB_PASSWORD=pharmacy_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSL_REQUIRE=False

# Security Headers & Cookies
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False

# Logging
LOG_LEVEL=INFO
