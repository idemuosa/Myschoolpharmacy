{
  "name": "pharmacy",
  "private": true,
  "version": "1.1.0",
  "description": "Josiah Pharmacy Management System",
  "author": "Josiah",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder",
    "windows:build": "npm run build && electron-builder --win",
    "windows:portable": "npm run build && electron-builder --win portable",
    "android:sync": "npm run build && npx cap copy && npx cap sync",
    "android:build": "npm run android:sync && npx cap open android",
    "android:release": "npm run build && npx cap sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.11.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@capacitor/android": "^5.5.0",
    "@capacitor/cli": "^5.5.0",
    "@capacitor/core": "^5.5.0",
    "@vitejs/plugin-react": "^4.1.0",
    "autoprefixer": "^10.4.16",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0",
    "eslint": "^8.52.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^4.5.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.josiah.pharmacy",
    "productName": "JosiahPharmacyPOS",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.ico",
      "certificateFile": null,
      "certificatePassword": null,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Josiah Pharmacy POS",
      "artifactName": "${productName}_Setup.${ext}"
    }
  }
}
